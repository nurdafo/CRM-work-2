{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nurainur-crm",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_NAME": "Нурайнур CRM",
    "META_AD_ACCOUNT_ID": "1623369248931085",
    "META_BUSINESS_ID": "1076837885516726",
    "META_APP_ID": "1378442990934699",
    "META_PAGE_ID": "1076700328863815",
    "META_FORM_ID": "28378756615092458",
    "META_CUSTOM_AUDIENCE_ID": "120251736250590568",
    "META_GRAPH_VERSION": "v26.0",
    "GOOGLE_SPREADSHEET_ID": "1EIaTnBDEoS-z5nIlIqgahkMfSbYelZVqK2xKi6u8aEY",
    "GOOGLE_SHEET_NAME": "Заявки",
    "TELEGRAM_CHAT_ID": "1750570674"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nurainur-crm",
      "database_id": "3279e626-eeaa-445a-b675-dd65a5c055ad",
      "migrations_dir": "./migrations"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webhooks/*"]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
